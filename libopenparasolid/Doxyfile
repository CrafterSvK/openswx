# Run from libopenparasolid: doxygen Doxyfile
PROJECT_NAME           = libopenparasolid
OUTPUT_DIRECTORY       = ../build/openparasolid-docs
INPUT                  = include/openparasolid doc
FILE_PATTERNS          = *.h *.h.in *.dox
EXTENSION_MAPPING      = in=C++
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS      = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXCLUDE_SYMBOLS        = OPENPARASOLID_*_H_

HAVE_DOT               = NO

WARN_IF_UNDOC_ENUM_VAL = YES
GENERATE_XML           = NO
