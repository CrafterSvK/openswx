# Run from libopenswstep: doxygen Doxyfile
PROJECT_NAME           = libopenswstep
OUTPUT_DIRECTORY       = ../build/openswstep-docs
INPUT                  = include/openswstep
FILE_PATTERNS          = *.h *.h.in
EXTENSION_MAPPING      = in=C++
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXCLUDE_SYMBOLS        = OPENSWSTEP_*_H_
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
